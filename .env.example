# ==============================================================================
# Smart NVR (Sistema de Videovigilancia Inteligente) — Environment Configuration
# ==============================================================================
# Copy this template to .env and adjust values for your environment.

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*
SECRET_KEY=smart-nvr-secret-key-change-in-production

# ------------------------------------------------------------------------------
# 2. Filesystem & Storage Retention
# ------------------------------------------------------------------------------
STORAGE_DIR=storage
RECORDINGS_DIR=storage/recordings
CLIPS_DIR=storage/recordings/clips
SNAPSHOTS_DIR=storage/recordings/snapshots
DB_PATH=storage/nvr.db
MODELS_DIR=models
YOLO_MODEL_PATH=models/yolov8n.onnx
MAX_STORAGE_GB=50.0
RETENTION_DAYS=14

# ------------------------------------------------------------------------------
# 3. Ingestion & Streaming Pacing
# ------------------------------------------------------------------------------
DEFAULT_FPS=15
RTSP_TRANSPORT=tcp
RTSP_STIMEOUT=5000000
FRAME_DROP_POLICY=drop_oldest
RECONNECT_DELAY_INITIAL=1.0
RECONNECT_DELAY_MAX=30.0
RECONNECT_BACKOFF_FACTOR=2.0
JPEG_QUALITY=75
STREAM_MAX_LATENCY_MS=150

# ------------------------------------------------------------------------------
# 4. Circular Buffer & Event Recording
# ------------------------------------------------------------------------------
PRE_ROLL_SECONDS=3.0
POST_ROLL_SECONDS=5.0
MAX_EVENT_DURATION_SECONDS=120.0

# ------------------------------------------------------------------------------
# 5. Hybrid Two-Phase Detection (MOG2 + Deep Learning)
# ------------------------------------------------------------------------------
MOG2_HISTORY=500
MOG2_VAR_THRESHOLD=16.0
MOG2_DETECT_SHADOWS=true
MOG2_MIN_CONTOUR_AREA=500
MOG2_SHADOW_THRESHOLD=200
MOG2_DOWNSCALE_WIDTH=320
MOG2_DOWNSCALE_HEIGHT=180
AI_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.50
AI_TARGET_CLASSES=person,car,motorcycle,bus,truck
AI_INFERENCE_FPS=5.0
AI_ENGINE_TIER=onnx

# ------------------------------------------------------------------------------
# 6. Gmail SMTP Alert Dispatching & Cooldown
# ------------------------------------------------------------------------------
# To generate a Google App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (2FA)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create an App Password for 'Mail' / 'Smart NVR' and paste the 16-character key below.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=tu_cuenta@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_EMAIL=tu_cuenta@gmail.com
ALERT_RECIPIENTS=alertas@ejemplo.com,seguridad@ejemplo.com
ALERT_COOLDOWN_SECONDS=60
ALERT_ENABLED=true
